{
  "name": "itseghosime-portfolio",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "web",
    "sanity"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace portfolio-web",
    "dev:studio": "npm run dev --workspace sanity-studio",
    "build": "npm run build --workspace sanity-studio && npm run build --workspace portfolio-web",
    "build:web": "npm run build --workspace portfolio-web",
    "build:studio": "npm run build --workspace sanity-studio",
    "lint": "npm run lint --workspace portfolio-web",
    "typecheck:studio": "tsc --noEmit -p sanity/tsconfig.json"
  },
  "engines": {
    "node": ">=20"
  }
}

